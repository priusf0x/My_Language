function herons_square(var a)
{
    var num = 10;
    var square = a;

    while (num > 0)
    {
        num = num - 1;
        square = (square + a / square) / 2;
    }

    return square;
}


function discriminant(var a, var b, var c)
{
    return b*b - 4*a*c;
}

function main()
{
    var a = scan(); var b = scan(); var c = scan();
    var discr = discriminant(a, b, c);
    print(discr);

    if (discr < 0)
    {
        print(0);
    }
    if (discr > 0)
    {
        print(1);
        var x_1 = (-b);
        print(x_1);
    }
}