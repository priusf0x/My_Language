function herons_square(var a)
{
    var num = 10;
    var square = a;

    while (num > 0)
    {
        num = num - 1;
        square = (square + a / square) / 2;
    }

    return square;
}

function solve_linear(var b, var c)
{
    return -c / b;
}


function discriminant(var a, var b, var c)
{
    return b*b - 4*a*c;
}

function main()
{
    var a = 1; var b = 10; var c = 4;

    if (a == 0)
    {
        if (b == 0)
        {
            if (c == 0)
            {
                print(0);
                print(0);
                print(0);
            }
            else
            {
                print(-1);
                print(-1);
                print(-1);
            }
        }
        else 
        {
            print(solve_linear(b, c));
        }
    }
    else 
    {
        var d = discriminant(a, b, c);

        if (d == 0)
        {
            print(-b/(2*a));
        }
        else if (d < 0)
        {
            print(-1);
            print(-1);
        }
        else
        {
            print((-b + herons_square(d)) / 2 / a);
            print((-b - herons_square(d)) / 2 / a);
        }
    }

    return 0;
}