var X_MAX = 30;
var Y_MAX = 30;
var RADIUS = 7;

function main()
{
    setscreen();

    var x = 0;
    var y = 0;

    while (y < Y_MAX)
    {
        x = 0;

        while (x < X_MAX)
        {
            if (((x - X_MAX / 2)*(x- X_MAX /2 )  + (y - Y_MAX /2 )*(y - Y_MAX / 2) * 4)
                    < RADIUS * RADIUS) 
            {
                set(x, y, 42)
            }
            x = x + 1;
        }
        y = y + 1;
    }

    draw();
}