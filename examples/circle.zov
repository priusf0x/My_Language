function main()
{
    var X_MAX = 30;
    var Y_MAX = 30;
    var RADIUS = 7;

    var x = 0;
    var y = 0;

    while (y < Y_MAX)
    {
        x = 0;

        while (x < X_MAX)
        {
            if (((x - X_MAX / 2)*(x- X_MAX /2 )  + (y - Y_MAX /2 )*(y - Y_MAX / 2) * 4)
                    < RADIUS * RADIUS) 
            {
                putchar(35);
            }
            else 
            {
                putchar(32);
            }
            x = x + 1;
        }
        y = y + 1;

        putchar(10);
    }
    return 0;
}